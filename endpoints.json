      "status": "Open"
    }
  },
  "GET /api/vulnerabilities/:vulnerability_id": {
    "description": "Serves a single vulnerability identified by its ID.",
    "exampleResponse": {
      "vulnerability": {
        "vulnerability_id": 1,
        "title": "Example vulnerability",
        "description": "An example vulnerability description.",
        "cve": "CVE-2026-0001",
        "cvss": 7.5,
        "contextual_severity": "High",
        "status": "Open"
      }
    }
  },
  "PATCH /api/vulnerabilities/:vulnerability_id": {
    "description": "Updates an existing vulnerability by its ID, such as changing its contextual severity.",
    "exampleRequest": {
      "contextual_severity": "Critical"
    }
  },
  "PATCH /api/vulnerabilities/:vulnerability_id/status": {
    "description": "Updates the status of an existing vulnerability by its ID.",
    "exampleRequest": {
      "status": "Resolved"
    },
    "exampleResponse": {
      "vulnerability": {
        "vulnerability_id": 1,
        "title": "Example vulnerability",
        "description": "An example vulnerability description.",
        "cve": "CVE-2026-0001",
        "cvss": 7.5,
        "contextual_severity": "High",
        "status": "Resolved"
      }
    }
  },
  "DELETE /api/vulnerabilities/:vulnerability_id": {
    "description": "Deletes a vulnerability identified by its ID."
  },
